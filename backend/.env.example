# AgriShift Backend Environment Configuration
# Copy this file to .env and fill in your genuine credentials
# NEVER commit .env to source control!

# Supabase Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-if-used-for-admin

# NASA Earthdata Authentication
# Generate from: https://urs.earthdata.nasa.gov/
NASA_EARTHDATA_TOKEN=your-nasa-earthdata-token

# Environment & CORS Configuration
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,https://your-vercel-domain.vercel.app
PORT=8000
