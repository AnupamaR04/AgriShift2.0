# AgriShift Frontend Environment Configuration
# Copy this file to .env.local and update with your real Supabase and backend credentials

# Supabase Project URL (From your Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public API Key (From your Supabase Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# AgriShift Backend FastAPI URL (Local development or Render deployment)
VITE_API_BASE_URL=http://localhost:8000
